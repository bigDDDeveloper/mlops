{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "stat",
      "title": "Model Ready",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "model_ready", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": { "steps": [
            { "color": "red", "value": null }, { "color": "green", "value": 1 }
          ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(api_requests_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Total Predictions",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(predictions_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Prediction Errors",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "prediction_errors_total", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Request Rate (req/s) by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum(rate(api_requests_total[1m])) by (endpoint)",
        "legendFormat": "{{endpoint}}", "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "p95 Request Latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(request_latency_seconds_bucket[5m])) by (le, endpoint))",
        "legendFormat": "{{endpoint}}", "refId": "A"
      }]
    },
    {
      "type": "piechart",
      "title": "Predictions by Label",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "expr": "sum(predictions_total) by (label)",
        "legendFormat": "{{label}}", "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Requests by Status Code",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "expr": "sum(rate(api_requests_total[1m])) by (status)",
        "legendFormat": "{{status}}", "refId": "A"
      }]
    }
  ],
  "schemaVersion": 38,
  "title": "HeartCare API Monitoring",
  "uid": "heartcare-api",
  "version": 1,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s"
}
